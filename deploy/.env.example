# ============ 运行时配置（复制为 .env 后填写，切勿提交到 Git） ============

# PostgreSQL（供 docker compose 初始化数据库）
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ledger

# 可选：数据库镜像（国内服务器拉不动 Docker Hub 时改成镜像站地址）
# DB_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# 可选：missing（默认，镜像不存在才拉取）/ always（每次强制拉取）\n# PULL_POLICY=missing

# 对外端口
HTTP_PORT=80

# 硅基流动 API
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_TEXT_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# 如需通过代理访问模型接口，填 http://127.0.0.1:7890；留空表示直连
LLM_PROXY=

# 应用
APP_ENV=prod
APP_PASSWORD=set-a-strong-access-password
ALLOWED_ORIGINS=https://your-domain.example.com
WORKER_ENABLED=true
TIMEZONE=Asia/Shanghai

# 上传
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=10
