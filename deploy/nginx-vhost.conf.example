# Optional: expose the stack through an existing host nginx on port 80.
#
#   1. copy to /etc/nginx/conf.d/min-ledger.conf
#   2. replace server_name with your domain (or <ip>.nip.io)
#   3. nginx -t && nginx -s reload
#
# The compose stack listens on 127.0.0.1:${HTTP_PORT} (default 8080).
server {
    listen 80;
    server_name ledger.example.com;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
